# LLM Provider API Keys
# Скопируйте этот файл в .env и заполните ключи для нужных провайдеров

# Ollama (локальный, не требует ключа)
OLLAMA_BASE_URL=http://localhost:11434

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenAI (ChatGPT)
OPENAI_API_KEY=your_openai_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_key_here

# xAI (Grok)
XAI_API_KEY=your_xai_key_here

# Cerebras
CEREBRAS_API_KEY=your_cerebras_key_here

# Kilo AI (OpenAI-compatible)
KILO_API_KEY=your_kilo_key_here
KILO_BASE_URL=https://api.kilo.ai/v1  # Настройте если отличается

# OpenRouter (unified LLM access)
OPENROUTER_API_KEY=your_openrouter_key_here

# По умолчанию используемый провайдер
DEFAULT_LLM_PROVIDER=ollama

# Модель по умолчанию для каждого провайдера
OLLAMA_DEFAULT_MODEL=qwen2.5:14b
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4.5-20250929
OPENAI_DEFAULT_MODEL=gpt-4o
DEEPSEEK_DEFAULT_MODEL=deepseek-chat
XAI_DEFAULT_MODEL=grok-2-latest
CEREBRAS_DEFAULT_MODEL=llama-3.3-70b
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
